# Third party dependencies — fetched by the build, never committed.
third_party/
.gitmodules

# Build output
build/
dist/
# Android externalNativeBuild (CMake) intermediates
.cxx/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Compiled binaries / libraries
*.a
*.so
# ...except the prebuilt Android core the Kotlin binding (and through it the
# Flutter plugin) ships
!bindings/kotlin/medut/src/main/jniLibs/**/*.so
# ...and the desktop cores the Flutter plugin bundles (scripts/build-linux.sh,
# .github/workflows/windows-dll.yml)
!bindings/flutter/linux/medut.so
*.dylib
*.dll
!bindings/flutter/windows/medut.dll
*.lib
*.exe
*.out
*.app
*.ipa
*.apk

# Object files
*.o
*.obj
*.lo
*.slo

# Python bindings
# Depth-independent so they also catch bindings/python/medut/... — the
# previous anchored forms missed the inner package directory.
__pycache__/
*.pyc
*.pyo
*.egg-info/
bindings/python/build/
bindings/python/dist/
# Copied here by bindings/python/build.sh from dist/<platform>/
bindings/python/medut/medut.so
bindings/python/medut/medut.pyd
bindings/python/medut/medut.dylib

# C++ bindings build artifacts
bindings/cpp/build/

# Flutter / Dart bindings
# Machine-local Android/Flutter SDK paths — generated per developer.
local.properties
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
bindings/flutter/example/build/

# Editor / IDE
.vscode/
.vs/
*.suo
*.user
*.sdf
*.opensdf
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code / Kilo
.claude/
.kilo/

# Unit-test binaries built by test/unit/Makefile.  (Some older ones are
# tracked by mistake and left alone; new ones stay out.)
/test/unit/test_ice_agent
/test/unit/test_ice_mod
/test/unit/test_ice_pair
/test/unit/test_ice_turn_stream
/test/unit/test_ice_sdp
/test/unit/test_dispatch_starve
/test/unit/test_sip_status
/test/unit/test_audio_processing
/test/unit/test_audio_processing_webrtc
/test/unit/webrtc_apm_test.o
/test/unit/test_aurecv_plc
/test/unit/test_jbuf_adapt
/test/unit/test_stats_loss

# Swift package: SwiftPM state.  Frameworks/Medut.xcframework is committed
# (scripts/build-ios.sh or scripts/fetch-prebuilt.sh refresh it).
bindings/swift/.build/
bindings/swift/.swiftpm/
