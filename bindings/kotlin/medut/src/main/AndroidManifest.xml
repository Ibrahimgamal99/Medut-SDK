<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SIP signalling + RTP media -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone capture for calls (runtime permission: request it before
         the first call) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODE_IN_COMMUNICATION and call-audio routing -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- ConnectivityManager default-network callback (drives handover) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(TRANSPORT_CELLULAR) for ICE multipath -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- MedutPush.wake holds a partial wake lock while a push is handled -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-managed ConnectionService (AndroidOptions.telecom) -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- The built-in incoming-call notification.  POST_NOTIFICATIONS is a
         runtime permission on API 33+: request it before the first call. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Only used once the app opts in: MedutAndroid.setStartOnBoot(). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="dev.medut.android.telecom.MedutConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <receiver
            android:name="dev.medut.android.telecom.MedutCallActionReceiver"
            android:exported="false" />
        <!-- Off until MedutAndroid.setStartOnBoot(context, true). -->
        <receiver
            android:name="dev.medut.android.MedutBootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Answer from the incoming-call notification: an activity, since
             Android 12 lets no receiver start one from a notification. -->
        <activity
            android:name="dev.medut.android.telecom.MedutAnswerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
