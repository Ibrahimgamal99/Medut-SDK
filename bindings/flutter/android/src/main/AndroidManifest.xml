<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SIP signalling + RTP media -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone capture for calls (runtime permission — the app must
         request it before the first call) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODE_IN_COMMUNICATION / speakerphone routing -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- ConnectivityManager network-change callbacks (drives handover) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(TRANSPORT_CELLULAR): keeps a second path up during a
         call for ICE multipath (EchoSDKConfig.iceMultipath); normal-level
         permission, granted at install -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
</manifest>
